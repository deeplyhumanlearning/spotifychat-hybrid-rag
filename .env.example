# Copy to .env. Never commit .env or real API keys.

# OpenAI (used through langchain-openai: ChatOpenAI + OpenAIEmbeddings)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Neo4j AuraDB cloud credentials (used through langchain-neo4j)
NEO4J_URI=neo4j+s://YOUR-AURA-INSTANCE.databases.neo4j.io
NEO4J_USERNAME=YOUR_AURA_USERNAME
NEO4J_PASSWORD=replace-with-your-aura-password
NEO4J_DATABASE=YOUR_AURA_DATABASE_NAME

# Optional web search. Search stays disabled until the user explicitly says Yes after the app asks.
WEB_SEARCH_PROVIDER=serper
SERPER_API_KEY=
SERPAPI_API_KEY=

# Optional LangSmith tracing of the LangChain pipeline. Leave LANGSMITH_TRACING=false to disable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spotifychat-hybrid-rag
# Only for non-US regions or self-hosted LangSmith, e.g. https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=

# Retrieval and app settings
RETRIEVAL_TOP_K=6
RRF_K=60
CHUNK_SIZE=1100
CHUNK_OVERLAP=150
SESSION_TTL_MINUTES=240
REQUEST_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:8501,https://spotifychat.labspace.tech
STREAMLIT_PORT=8501
